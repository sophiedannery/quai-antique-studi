{% extends 'base.html.twig' %}

{% block title %}Ajouter un restaurant
{% endblock %}

{% block body %}

	<section id="bg-hero-accueil" class="bg-hero-accueil d-flex flex-column align-items-center justify-content-center">
		<h1 class="text-white">Ajouter un restaurant</h1>
	</section>

	<section class="container p-4">

		{% if error is defined %}
			<div class="alert alert-danger">
				{{ error }}
			</div>
		{% endif %}

		<form method="post" id="restaurant-form">

			<div class="pb-4">
				<label for="name">Nom du restaurant</label>
				<input type="text" name="name" id="name" class="form-control" required>
			</div>

			<div class="pb-4">
				<label for="description">Description</label>
				<textarea name="description" id="description" class="form-control"></textarea>
			</div>

			<div class="pb-4">
				<label for="maxGuest">Nombre maximum de couverts</label>
				<input type="number" name="maxGuest" id="maxGuest" class="form-control" min="1" required>
			</div>

			<div class="pb-4">
				<label for="amOpeningTime">Horaires midi (séparés par des virgules)</label>
				<input type="text" name="amOpeningTime" id="amOpeningTime" class="form-control" placeholder="11:30,12:00,12:30" required>
			</div>

			<div class="pb-4">
				<label for="pmOpeningTime">Horaires soir (séparés par des virgules)</label>
				<input type="text" name="pmOpeningTime" id="pmOpeningTime" class="form-control" placeholder="19:00,19:30,20:00" required>
			</div>

			<input type="hidden" name="_csrf_token" value="{{ csrf_token('create_restaurant') }}">

			<div class="text-center">
				<button class="btn btn-lg btn-primary" id="btn-creation-restaurant" type="submit">
					Créer le restaurant
				</button>
			</div>

		</form>

		<div id="restaurant-result" class="mt-3"></div>


	</section>

{% endblock %}
