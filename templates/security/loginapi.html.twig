{% extends 'base.html.twig' %}

{% block title %}Connexion
{% endblock %}

{% block body %}

	<section id="bg-hero-accueil" class="bg-hero-accueil d-flex flex-column align-items-center justify-content-center">
		<h1 id="hero-heading" class="text-white">Connexion API</h1>
	</section>


	<section class="container p-4">

		<form method="post" id="signinForm">

			<div class="pb-4">
				<label for="EmailInput" class="form-label">Adresse e-mail</label>
				<input type="email" name="email" id="EmailInput" class="form-control" placeholder="exemple@mail.com" required>
				<div class="invalid-feedback">Le mail et le mot de passe ne correspondent pas.</div>
			</div>

			<div class="pb-4">
				<label for="PasswordInput">Mot de passe</label>
				<input type="password" name="mdp" id="PasswordInput" class="form-control" required>
			</div>

			<div class="text-center">
				<button class="btn btn-lg btn-primary" id="btnSignin" type="button">
					Connexion
				</button>
			</div>
		</form>

		<div class="text-center pt-4">
			<a href="{{ path('app_registration')}}">Vous n'avez pas encore de compte ?
				<br>Inscrivez-vous ici !</a>
		</div>
	</section>

	<script src="/js/connection.js" defer></script>


{% endblock %}
