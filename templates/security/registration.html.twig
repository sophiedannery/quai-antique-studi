{% extends 'base.html.twig' %}

{% block title %}Inscription
{% endblock %}

{% block body %}

	<section id="bg-hero-accueil" class="bg-hero-accueil d-flex flex-column align-items-center justify-content-center">
		<h1 id="hero-heading" class="text-white">Inscription API</h1>
	</section>


	<section class="container p-4">

		<form method="post">

			<div class="pb-4">
				<label for="NomInput" class="form-label">Nom</label>
				<input type="text" name="Nom" id="NomInput" class="form-control" required placeholder="Votre nom">
			</div>

			<div class="pb-4">
				<label for="PrenomInput" class="form-label">Prénom</label>
				<input type="text" name="Prenom" id="PrenomInput" class="form-control" required placeholder="Votre prénom">
			</div>

			<div class="pb-4">
				<label for="EmailInput" class="form-label">Email</label>
				<input type="email" name="Email" id="EmailInput" class="form-control" required placeholder="exemple@mail.com">
			</div>

			<div class="pb-4">
				<label for="PasswordInput" class="form-label">Mot de passe</label>
				<input type="password" name="Password" id="PasswordInput" class="form-control" required>
				<div class="invalid-feedback">Le mot de passe doit contenit au moins 8 caractères, 1 majuscule, 1 caractère spécial et un nombre.</div>
				<div class="valid-feedback">Le mot de passe est assez robuste.</div>

			</div>
			<div class="pb-4">
				<label for="ValidatePasswordInput" class="form-label">Confirmez votre mot de passe</label>
				<input type="password" name="PasswordConfirm" id="ValidatePasswordInput" class="form-control" required>
				<div class="invalid-feedback">Les mots de passe ne correspondent pas.</div>

			</div>

			<div class="text-center">
				<button class="btn btn-lg btn-primary" type="submit" id="btn-validation-inscription">
					Inscription
				</button>
			</div>
		</form>

		<div class="text-center pt-4">
			<a href="{{ path('app_loginapi')}}">Vous avez déjà un compte ?
				<br>Connectez-vous ici !</a>
		</div>
	</section>

	<script src="/js/registration.js" defer></script>


{% endblock %}
