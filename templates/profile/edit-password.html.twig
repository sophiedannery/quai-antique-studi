{% extends 'base.html.twig' %}

{% block title %}Hello ProfileController!
{% endblock %}

{% block body %}
	<section id="bg-hero-accueil" class="bg-hero-accueil d-flex flex-column align-items-center justify-content-center">
		<h1 id="hero-heading" class="text-white">Modifier mon mot de passe</h1>
	</section>

	<form method="post">

		<section class="container p-4">

			<div class="pb-4">
				<label for="NomInput">Nom</label>
				<input type="text" class="form-control" id="NomInput" placeholder"votre nom">

			</div>


			<div class="text-center">
				<button class="btn btn-lg btn-primary" type="submit">
					Modifier mon mot de passe
				</button>
			</div>
		</form>

		<div class="text-center pt-4">
			<a href="{{ path('app_profile') }}">Modifier mes informations personnels</a>
		</div>


	</section>


{% endblock %}
